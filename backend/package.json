{
  "name": "sigel-backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "dev": "yarn build && node --watch-path=./src --env-file=.env dist/main.js",
    "dev:debug": "yarn build && node --watch-path=./src --inspect=0.0.0.0:9229 --enable-source-maps --env-file=.env dist/main.js",
    "migration:create": "yarn typeorm migration:create src/config/typeorm/migrations/$npm_config_name",
    "migration:run": "yarn build && yarn typeorm migration:run -d dist/config/typeorm/data-source.cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@vinejs/vine": "^4.4.0",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
