{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to backend (Docker :9229)",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}/backend",
      "remoteRoot": "/app",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/backend/dist/**/*.js"],
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
